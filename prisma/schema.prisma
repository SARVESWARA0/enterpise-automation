generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  PENDING
  ONBOARDING
  ACTIVE
  FAILED
}

enum WorkflowStatus {
  PENDING
  PLANNING
  RUNNING
  COMPLETED
  FAILED
  ESCALATED
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRIED
  ESCALATED
  AWAITING_CLARIFICATION
  SKIPPED
}

model Employee {
  id           String         @id @default(uuid())
  employeeId   String?        @map("employee_id")
  name         String
  email        String         @unique
  managerId    String?        @map("manager_id")
  companyEmail String?        @map("company_email")
  role         String
  department   String
  buddy        String?
  availabilityStatus String?  @default("available") @map("availability_status")
  status       EmployeeStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  workflows    Workflow[]

  @@map("employees")
}

model Workflow {
  id           String         @id @default(uuid())
  type         String
  entityId     String?        @map("entity_id")
  triggerEvent String         @map("trigger_event")
  inputData    Json?          @map("input_data")
  status       WorkflowStatus @default(PENDING)
  plan         Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  employee  Employee?  @relation(fields: [entityId], references: [id])
  steps     Step[]
  agentLogs AgentLog[]
  auditLogs AuditLog[]

  @@map("workflows")
}

model Step {
  id               String     @id @default(uuid())
  workflowId       String     @map("workflow_id")
  stepName         String     @map("step_name")
  stepType         String     @map("step_type")
  status           StepStatus @default(PENDING)
  retryCount       Int        @default(0) @map("retry_count")
  maxRetries       Int        @default(2) @map("max_retries")
  assignedAgent    String?    @map("assigned_agent")
  toolName         String?    @map("tool_name")
  inputData        Json?      @map("input_data")
  currentOutput    Json?      @map("current_output")
  fallbackBehavior String?    @map("fallback_behavior")
  dependencyOrder  Int        @default(0) @map("dependency_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  workflow  Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentLogs AgentLog[]
  auditLogs AuditLog[]

  @@map("steps")
}

model AgentLog {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  stepId     String?  @map("step_id")
  agentName  String   @map("agent_name")
  action     String
  toolName   String?  @map("tool_name")
  input      Json?
  output     Json?
  durationMs Int?     @map("duration_ms")
  timestamp  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  step     Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("agent_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  stepId      String?  @map("step_id")
  decision    String?
  reason      String?
  actionTaken String?  @map("action_taken")
  agentName   String?  @map("agent_name")
  toolName    String?  @map("tool_name")
  retryCount  Int?     @map("retry_count")
  status      String?
  timestamp   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  step     Step?    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Meeting {
  meetingId   String   @id @default(uuid()) @map("meeting_id")
  transcript  String
  participants Json
  meetingDate DateTime @default(now()) @map("meeting_date")
  source      String?
  createdAt   DateTime @default(now()) @map("created_at")
  tasks       Task[]

  @@map("meetings")
}

model Task {
  taskId            String    @id @default(uuid()) @map("task_id")
  title             String
  description       String
  owner             String?
  status            String
  priority          String    @default("medium")
  dueDate           DateTime? @map("due_date")
  sourceMeetingId   String?   @map("source_meeting_id")
  rawText           String?   @map("raw_text")
  parsedIntent      Json?     @map("parsed_intent")
  reasonForCreation String?   @map("reason_for_creation")
  confidenceScore   Float?    @default(0) @map("confidence_score")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  meeting     Meeting?      @relation(fields: [sourceMeetingId], references: [meetingId], onDelete: SetNull)
  actionItems ActionItem[]

  @@map("tasks")
}

model ActionItem {
  actionItemId   String   @id @default(uuid()) @map("action_item_id")
  taskId         String?  @map("task_id")
  rawText        String   @map("raw_text")
  parsedIntent   Json?    @map("parsed_intent")
  ownerDetected  String?  @map("owner_detected")
  ambiguityFlag  Boolean  @default(false) @map("ambiguity_flag")
  ambiguityReason String? @map("ambiguity_reason")
  possibleOwners Json     @default("[]") @map("possible_owners")
  createdAt      DateTime @default(now()) @map("created_at")

  task Task? @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@map("action_items")
}

model ApprovalRequest {
  approvalId          String    @id @default(uuid()) @map("approval_id")
  requestType         String    @map("request_type")
  currentApprover     String?   @map("current_approver")
  delegateApprover    String?   @map("delegate_approver")
  status              String
  slaDeadline         DateTime  @map("sla_deadline")
  lastReminderSentAt  DateTime? @map("last_reminder_sent_at")
  emailSentStatus     String?   @map("email_sent_status")
  rerouteReason       String?   @map("reroute_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("approval_requests")
}

model WorkflowRun {
  workflowRunId    String    @id @default(uuid()) @map("workflow_run_id")
  workflowType     String    @map("workflow_type")
  currentStep      String?   @map("current_step")
  stepStatus       String    @default("pending") @map("step_status")
  inputPayload     Json?     @map("input_payload")
  outputPayload    Json?     @map("output_payload")
  errorMessage     String?   @map("error_message")
  retryCount       Int       @default(0) @map("retry_count")
  escalationStatus String?   @default("none") @map("escalation_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  steps            WorkflowRunStep[]

  @@map("workflow_runs")
}

model WorkflowRunStep {
  id            String   @id @default(uuid())
  workflowRunId String   @map("workflow_run_id")
  stepName      String   @map("step_name")
  stepStatus    String   @map("step_status")
  inputPayload  Json?    @map("input_payload")
  outputPayload Json?    @map("output_payload")
  errorMessage  String?  @map("error_message")
  retryCount    Int      @default(0) @map("retry_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [workflowRunId], onDelete: Cascade)

  @@map("workflow_run_steps")
}

model EnterpriseAuditLog {
  logId      String   @id @default(uuid()) @map("log_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  eventType  String   @map("event_type")
  message    String
  actor      String
  timestamp  DateTime @default(now())
  metadata   Json?

  @@map("enterprise_audit_logs")
}
